{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medizinanders.local/schemas/A11.schema.json",
  "title": "MedizinAnders A11 – YouTube-Publikationsnachweis",
  "description": "Self-contained JSON Schema 2020-12. Strukturelle Validierung ersetzt weder Quellenprüfung noch externe Gate-Freigabe.",
  "type": "object",
  "properties": {
    "artefakt_id": {
      "const": "A11"
    },
    "projekt_id": {
      "type": "string",
      "pattern": "^MA-[0-9]{8}-[0-9]{3}$"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "datum": {
      "$ref": "#/$defs/iso_datum"
    },
    "autor": {
      "$ref": "#/$defs/text"
    },
    "status": {
      "enum": [
        "Entwurf",
        "geprüft",
        "freigegeben",
        "produziert",
        "veröffentlicht"
      ],
      "description": "Historischer Dateistatus; keine wirksame Gate-Freigabe oder Freigabevererbung."
    },
    "eingaben": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/eingabe"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "quellen": {
      "$ref": "#/$defs/id_liste"
    },
    "offene_punkte": {
      "$ref": "#/$defs/text_liste"
    },
    "gesperrt": {
      "type": "boolean"
    },
    "sperrgrund": {
      "type": "string"
    },
    "beispiel": {
      "type": "boolean"
    },
    "inhalt": {
      "type": "object",
      "properties": {
        "final_sha256": {
          "$ref": "#/$defs/sha256_oder_leer"
        },
        "video_id": {
          "type": "string"
        },
        "url": {
          "$ref": "#/$defs/url_oder_leer"
        },
        "sichtbarkeit": {
          "enum": [
            "private",
            "unlisted",
            "public"
          ]
        },
        "veroeffentlicht_am": {
          "$ref": "#/$defs/iso_datum_oder_null"
        },
        "ki_kennzeichnung": {
          "type": "object",
          "properties": {
            "erforderlich": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "gesetzt": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "nachweis": {
              "type": "string"
            }
          },
          "required": [
            "erforderlich",
            "gesetzt",
            "nachweis"
          ],
          "additionalProperties": false
        },
        "zielgruppe": {
          "type": "object",
          "properties": {
            "fuer_kinder": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "begruendung": {
              "$ref": "#/$defs/text"
            }
          },
          "required": [
            "fuer_kinder",
            "begruendung"
          ],
          "additionalProperties": false
        },
        "werbung": {
          "type": "object",
          "properties": {
            "enthaelt_bezahlte_werbung": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "kennzeichnung_gesetzt": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "details": {
              "$ref": "#/$defs/text"
            }
          },
          "required": [
            "enthaelt_bezahlte_werbung",
            "kennzeichnung_gesetzt",
            "details"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "final_sha256",
        "video_id",
        "url",
        "sichtbarkeit",
        "veroeffentlicht_am",
        "ki_kennzeichnung",
        "zielgruppe",
        "werbung"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "artefakt_id",
    "projekt_id",
    "version",
    "datum",
    "autor",
    "status",
    "eingaben",
    "quellen",
    "offene_punkte",
    "gesperrt",
    "sperrgrund",
    "beispiel",
    "inhalt"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "gesperrt": {
            "const": true
          }
        },
        "required": [
          "gesperrt"
        ]
      },
      "then": {
        "properties": {
          "sperrgrund": {
            "$ref": "#/$defs/text"
          }
        }
      },
      "else": {
        "properties": {
          "sperrgrund": {
            "const": ""
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "veröffentlicht"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "inhalt": {
            "properties": {
              "final_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "video_id": {
                "$ref": "#/$defs/text"
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              },
              "veroeffentlicht_am": {
                "$ref": "#/$defs/iso_datum"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "eingabe": {
      "type": "object",
      "properties": {
        "artefakt_id": {
          "type": "string",
          "pattern": "^A(?:0[1-9]|1[0-2])$"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "artefakt_id",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "id_liste": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identifikator"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "identifikator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "iso_datum": {
      "type": "string",
      "anyOf": [
        {
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
        }
      ],
      "description": "ISO-8601-Datum oder RFC-3339-Zeitpunkt mit Zeitzone."
    },
    "iso_datum_oder_null": {
      "anyOf": [
        {
          "$ref": "#/$defs/iso_datum"
        },
        {
          "type": "null"
        }
      ]
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 der tatsächlichen Datei, 64 kleingeschriebene Hexzeichen."
    },
    "sha256_oder_leer": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "const": ""
        }
      ],
      "description": "Im Entwurf leer, bis die tatsächliche Datei vorliegt; niemals einen Hash erfinden."
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "text_liste": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      },
      "minItems": 0
    },
    "url_oder_leer": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        {
          "const": ""
        }
      ]
    }
  }
}
