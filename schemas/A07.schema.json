{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medizinanders.local/schemas/A07.schema.json",
  "title": "MedizinAnders A07 – Freeze, Preflight und QA",
  "description": "Self-contained JSON Schema 2020-12. Strukturelle Validierung ersetzt weder Quellenprüfung noch externe Gate-Freigabe.",
  "type": "object",
  "properties": {
    "artefakt_id": {
      "const": "A07"
    },
    "projekt_id": {
      "type": "string",
      "pattern": "^MA-[0-9]{8}-[0-9]{3}$"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "datum": {
      "$ref": "#/$defs/iso_datum"
    },
    "autor": {
      "$ref": "#/$defs/text"
    },
    "status": {
      "enum": [
        "Entwurf",
        "geprüft",
        "freigegeben",
        "produziert",
        "veröffentlicht"
      ],
      "description": "Historischer Dateistatus; keine wirksame Gate-Freigabe oder Freigabevererbung."
    },
    "eingaben": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/eingabe"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "quellen": {
      "$ref": "#/$defs/id_liste"
    },
    "offene_punkte": {
      "$ref": "#/$defs/text_liste"
    },
    "gesperrt": {
      "type": "boolean"
    },
    "sperrgrund": {
      "type": "string"
    },
    "beispiel": {
      "type": "boolean"
    },
    "inhalt": {
      "type": "object",
      "properties": {
        "freeze_revision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^r[0-9]{3,}$"
            },
            {
              "const": ""
            }
          ]
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256_oder_leer"
        },
        "preflight": {
          "$ref": "#/$defs/qa"
        },
        "qa": {
          "$ref": "#/$defs/qa"
        }
      },
      "required": [
        "freeze_revision",
        "manifest_sha256",
        "preflight",
        "qa"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "qa": {
                "properties": {
                  "ergebnis": {
                    "const": "freigabefaehig"
                  }
                },
                "required": [
                  "ergebnis"
                ]
              }
            },
            "required": [
              "qa"
            ]
          },
          "then": {
            "properties": {
              "freeze_revision": {
                "type": "string",
                "pattern": "^r[0-9]{3,}$"
              },
              "manifest_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "preflight": {
                "properties": {
                  "ergebnis": {
                    "const": "freigabefaehig"
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "artefakt_id",
    "projekt_id",
    "version",
    "datum",
    "autor",
    "status",
    "eingaben",
    "quellen",
    "offene_punkte",
    "gesperrt",
    "sperrgrund",
    "beispiel",
    "inhalt"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "gesperrt": {
            "const": true
          }
        },
        "required": [
          "gesperrt"
        ]
      },
      "then": {
        "properties": {
          "sperrgrund": {
            "$ref": "#/$defs/text"
          }
        }
      },
      "else": {
        "properties": {
          "sperrgrund": {
            "const": ""
          }
        }
      }
    }
  ],
  "$defs": {
    "eingabe": {
      "type": "object",
      "properties": {
        "artefakt_id": {
          "type": "string",
          "pattern": "^A(?:0[1-9]|1[0-2])$"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "artefakt_id",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "properties": {
        "datei": {
          "$ref": "#/$defs/text"
        },
        "problem": {
          "$ref": "#/$defs/text"
        },
        "soll": {
          "$ref": "#/$defs/text"
        },
        "ist": {
          "$ref": "#/$defs/text"
        },
        "schwere": {
          "enum": [
            "K0",
            "K1",
            "K2"
          ]
        },
        "rueckweg": {
          "$ref": "#/$defs/text"
        },
        "offen": {
          "type": "boolean"
        }
      },
      "required": [
        "datei",
        "problem",
        "soll",
        "ist",
        "schwere",
        "rueckweg",
        "offen"
      ],
      "additionalProperties": false
    },
    "id_liste": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identifikator"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "identifikator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "iso_datum": {
      "type": "string",
      "anyOf": [
        {
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
        }
      ],
      "description": "ISO-8601-Datum oder RFC-3339-Zeitpunkt mit Zeitzone."
    },
    "pflichtpruefung": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "enum": [
            "bestanden",
            "fehlgeschlagen",
            "nicht_geprueft",
            "nicht_anwendbar"
          ]
        },
        "nachweis": {
          "type": "string"
        },
        "begruendung": {
          "type": "string"
        },
        "art": {
          "enum": [
            "technisch",
            "menschlich"
          ]
        }
      },
      "required": [
        "name",
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "nicht_anwendbar"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "begruendung"
            ],
            "properties": {
              "begruendung": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      ]
    },
    "qa": {
      "type": "object",
      "properties": {
        "ergebnis": {
          "enum": [
            "freigabefaehig",
            "nacharbeit_erforderlich",
            "pruefung_unvollstaendig"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          },
          "minItems": 0
        },
        "pflichtpruefungen": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pflichtpruefung"
          },
          "minItems": 0
        }
      },
      "required": [
        "ergebnis",
        "findings",
        "pflichtpruefungen"
      ],
      "additionalProperties": false,
      "description": "Prüfbericht, keine Freigabe. Effektive Freigaben liegen separat mit exakten Hashreferenzen vor.",
      "allOf": [
        {
          "if": {
            "properties": {
              "ergebnis": {
                "const": "freigabefaehig"
              }
            },
            "required": [
              "ergebnis"
            ]
          },
          "then": {
            "properties": {
              "findings": {
                "items": {
                  "not": {
                    "properties": {
                      "offen": {
                        "const": true
                      },
                      "schwere": {
                        "enum": [
                          "K0",
                          "K1"
                        ]
                      }
                    },
                    "required": [
                      "offen",
                      "schwere"
                    ]
                  }
                }
              },
              "pflichtpruefungen": {
                "minItems": 1,
                "items": {
                  "properties": {
                    "status": {
                      "enum": [
                        "bestanden",
                        "nicht_anwendbar"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 der tatsächlichen Datei, 64 kleingeschriebene Hexzeichen."
    },
    "sha256_oder_leer": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "const": ""
        }
      ],
      "description": "Im Entwurf leer, bis die tatsächliche Datei vorliegt; niemals einen Hash erfinden."
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "text_liste": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      },
      "minItems": 0
    }
  }
}
