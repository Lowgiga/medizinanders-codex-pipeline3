{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medizinanders.local/schemas/A09.schema.json",
  "title": "MedizinAnders A09 – Finalvideo und Untertitel",
  "description": "Self-contained JSON Schema 2020-12. Strukturelle Validierung ersetzt weder Quellenprüfung noch externe Gate-Freigabe.",
  "type": "object",
  "properties": {
    "artefakt_id": {
      "const": "A09"
    },
    "projekt_id": {
      "type": "string",
      "pattern": "^MA-[0-9]{8}-[0-9]{3}$"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "datum": {
      "$ref": "#/$defs/iso_datum"
    },
    "autor": {
      "$ref": "#/$defs/text"
    },
    "status": {
      "enum": [
        "Entwurf",
        "geprüft",
        "freigegeben",
        "produziert",
        "veröffentlicht"
      ],
      "description": "Historischer Dateistatus; keine wirksame Gate-Freigabe oder Freigabevererbung."
    },
    "eingaben": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/eingabe"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "quellen": {
      "$ref": "#/$defs/id_liste"
    },
    "offene_punkte": {
      "$ref": "#/$defs/text_liste"
    },
    "gesperrt": {
      "type": "boolean"
    },
    "sperrgrund": {
      "type": "string"
    },
    "beispiel": {
      "type": "boolean"
    },
    "inhalt": {
      "type": "object",
      "properties": {
        "final_pfad": {
          "$ref": "#/$defs/text"
        },
        "final_sha256": {
          "$ref": "#/$defs/sha256_oder_leer"
        },
        "srt_pfad": {
          "$ref": "#/$defs/text"
        },
        "srt_sha256": {
          "$ref": "#/$defs/sha256_oder_leer"
        },
        "aenderungen": {
          "$ref": "#/$defs/text_liste"
        }
      },
      "required": [
        "final_pfad",
        "final_sha256",
        "srt_pfad",
        "srt_sha256",
        "aenderungen"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "artefakt_id",
    "projekt_id",
    "version",
    "datum",
    "autor",
    "status",
    "eingaben",
    "quellen",
    "offene_punkte",
    "gesperrt",
    "sperrgrund",
    "beispiel",
    "inhalt"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "gesperrt": {
            "const": true
          }
        },
        "required": [
          "gesperrt"
        ]
      },
      "then": {
        "properties": {
          "sperrgrund": {
            "$ref": "#/$defs/text"
          }
        }
      },
      "else": {
        "properties": {
          "sperrgrund": {
            "const": ""
          }
        }
      }
    }
  ],
  "$defs": {
    "eingabe": {
      "type": "object",
      "properties": {
        "artefakt_id": {
          "type": "string",
          "pattern": "^A(?:0[1-9]|1[0-2])$"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "artefakt_id",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "id_liste": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identifikator"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "identifikator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "iso_datum": {
      "type": "string",
      "anyOf": [
        {
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
        }
      ],
      "description": "ISO-8601-Datum oder RFC-3339-Zeitpunkt mit Zeitzone."
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 der tatsächlichen Datei, 64 kleingeschriebene Hexzeichen."
    },
    "sha256_oder_leer": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "const": ""
        }
      ],
      "description": "Im Entwurf leer, bis die tatsächliche Datei vorliegt; niemals einen Hash erfinden."
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "text_liste": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      },
      "minItems": 0
    }
  }
}
